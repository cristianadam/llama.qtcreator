{
    "Id" : "llamacpp",
    "Name" : "llama.qtcreator",
    "Version" : "${IDE_VERSION}",
    "CompatVersion" : "${IDE_VERSION_COMPAT}",
    "Vendor" : "ggml-org",
    "VendorId" : "ggml",
    "Copyright" : "(C) 2025 The llama.qtcreator Contributors, ${IDE_COPYRIGHT}",
    "License" : "MIT",
    "Description": "llama.cpp infill completion plugin for Qt Creator",
    "LongDescription" : ${LONG_DESCRIPTION},
    "Url" : "https://github.com/ggml-org/llama.qtcreator",
    "DocumentationUrl" : "",
    ${IDE_PLUGIN_DEPENDENCIES},
    "Mimetypes" : [
        "<?xml version='1.0'?>",
        "<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>",
        "    <mime-type type='text/x-llama.qtcreator'>",
        "        <sub-class-of type='text/plain'/>",
        "        <comment>llama.cpp conversation</comment>",
        "        <glob pattern='*.llama'/>",
        "    </mime-type>",
        "</mime-info>"
    ]
}
